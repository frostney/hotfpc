#!/usr/bin/env instantfpc
program StampVersion;

{ Writes [package].version of lwpt.toml into build/generated/Version.inc, so that
  `hotfpc --version` comes from the manifest. Run by `lwpt build` as a prebuild hook, from
  the project root. }

{$mode delphi}{$H+}

uses
  Classes,
  SysUtils;

const
  ManifestPath = 'lwpt.toml';
  OutputPath = 'build/generated/Version.inc';

function PackageVersion: string;
var
  Manifest: TStringList;
  Line: string;
  InPackage: Boolean;
  Index, Quote: Integer;
begin
  Result := '';
  InPackage := False;
  Manifest := TStringList.Create;
  try
    Manifest.LoadFromFile(ManifestPath);
    for Index := 0 to Manifest.Count - 1 do
    begin
      Line := Trim(Manifest[Index]);
      if (Line <> '') and (Line[1] = '[') then
        InPackage := Line = '[package]'
      else if InPackage and (Copy(Line, 1, 7) = 'version') then
      begin
        Quote := Pos('"', Line);
        Result := Copy(Line, Quote + 1, MaxInt);
        Result := Copy(Result, 1, Pos('"', Result) - 1);
        Exit;
      end;
    end;
  finally
    Manifest.Free;
  end;
end;

var
  Output: TStringList;
  Version: string;
begin
  Version := PackageVersion;
  if Version = '' then
  begin
    WriteLn(StdErr, 'StampVersion: no [package] version in ', ManifestPath);
    Halt(1);
  end;
  Output := TStringList.Create;
  try
    Output.Add('{ Generated by scripts/StampVersion.pas from ' + ManifestPath + '; do not edit. }');
    Output.Add('const');
    Output.Add('  HotFPCVersion = ''' + Version + ''';');
    ForceDirectories(ExtractFileDir(OutputPath));
    Output.SaveToFile(OutputPath);
  finally
    Output.Free;
  end;
end.
