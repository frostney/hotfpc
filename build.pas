#!/usr/bin/env instantfpc
program Build;

{ The build entry point of hotfpc (docs/build-system.md). Run from the repository root:

    instantfpc build.pas [target...] [--production] [-- fpc options]

  Targets:
    (none)    a clean development build of every binary: hotfpc and the unit tests
    hotfpc    build/hotfpc (build/hotfpc.exe for a Windows target)
    tests     build hotfpc with its unit tests (source/HotFPC.Test.inc) as build/tests/hotfpc-tests
              and run them
    embed     only write source/HotFPC.AgentSource.inc from the agent's source
    clean     remove build/; combine it with other targets to rebuild from nothing

  Every compile of hotfpc first writes source/HotFPC.AgentSource.inc from
  source/HotFPC.Agent.pas, so the binary always carries the agent it was built with. The
  file is committed, so `fpc source/HotFPC.pas` works without this script. The
  compiler is `fpc` on PATH, or the FPC environment variable.
  A development build turns on the checks the sources rely on: overflow, range, stack and
  object checks, and assertions. --production builds with optimisation and without them.
  Options after -- go to every compile, for example `-- -Twin64 -Px86_64`. }

{$mode delphi}{$H+}

uses
  Classes,
  Process,
  SysUtils;

const
  SourceDirectory = 'source';
  BuildDirectory = 'build';
  AgentSourcePath = 'source/HotFPC.Agent.pas';
  EmbeddedSourcePath = 'source/HotFPC.AgentSource.inc';
  DriverSourcePath = 'source/HotFPC.pas';
  TestsName = 'hotfpc-tests';
  TestsDefine = '-dHOTFPC_TESTS';
  { A string literal may not exceed 255 characters. }
  LiteralLimit = 200;
  DevelopmentOptions: array[0..6] of string = ('-gl', '-B', '-Co', '-Cr', '-Ct', '-CR', '-Sa');
  ProductionOptions: array[0..3] of string = ('-dPRODUCTION', '-O2', '-Xs', '-B');

var
  Targets: TStringList;
  CompilerOptions: TStringList;
  Production: Boolean;
  Compiler: string;

{ A Pascal expression for one line of source: quoted pieces of at most LiteralLimit
  characters, other characters as #nn. }
function LineExpression(const ALine: string): string;
var
  Index, LiteralLength: Integer;
begin
  if ALine = '' then
    Exit('''''');
  Result := '';
  LiteralLength := 0;
  for Index := 1 to Length(ALine) do
    if (ALine[Index] >= ' ') and (ALine[Index] <= '~') then
    begin
      if LiteralLength = 0 then
      begin
        if Result <> '' then
          Result := Result + ' + ';
        Result := Result + '''';
      end;
      if ALine[Index] = '''' then
        Result := Result + ''''''
      else
        Result := Result + ALine[Index];
      Inc(LiteralLength);
      if LiteralLength = LiteralLimit then
      begin
        Result := Result + '''';
        LiteralLength := 0;
      end;
    end
    else
    begin
      if LiteralLength > 0 then
        Result := Result + '''';
      LiteralLength := 0;
      if Result <> '' then
        Result := Result + ' + ';
      Result := Result + '#' + IntToStr(Ord(ALine[Index]));
    end;
  if LiteralLength > 0 then
    Result := Result + '''';
end;

procedure AddLineArray(const AOutput: TStringList; const AName, APath: string);
var
  Source: TStringList;
  Index: Integer;
  Separator: string;
begin
  Source := TStringList.Create;
  try
    Source.LoadFromFile(APath);
    AOutput.Add('  ' + AName + ': array[0..' + IntToStr(Source.Count - 1) + '] of string = (');
    for Index := 0 to Source.Count - 1 do
    begin
      if Index < Source.Count - 1 then
        Separator := ','
      else
        Separator := '';
      AOutput.Add('    ' + LineExpression(Source[Index]) + Separator);
    end;
    AOutput.Add('  );');
  finally
    Source.Free;
  end;
end;

{ Writes the agent's source into the include file the driver embeds. The file is left alone
  when it is already current. }
procedure EmbedAgent;
var
  Output, Existing: TStringList;
begin
  Output := TStringList.Create;
  Existing := TStringList.Create;
  try
    Output.Add('{ Generated by build.pas from ' + AgentSourcePath + '; do not edit. }');
    Output.Add('const');
    AddLineArray(Output, 'AgentSourceLines', AgentSourcePath);
    if FileExists(EmbeddedSourcePath) then
      Existing.LoadFromFile(EmbeddedSourcePath);
    if Existing.Text <> Output.Text then
    begin
      Output.SaveToFile(EmbeddedSourcePath);
      WriteLn('wrote ', EmbeddedSourcePath);
    end;
  finally
    Output.Free;
    Existing.Free;
  end;
end;

function IsWindowsTarget: Boolean;
var
  Index: Integer;
begin
  Result := {$IFDEF WINDOWS}True{$ELSE}False{$ENDIF};
  for Index := 0 to CompilerOptions.Count - 1 do
    if Copy(CompilerOptions[Index], 1, 2) = '-T' then
      Result := Copy(CompilerOptions[Index], 1, 5) = '-Twin';
end;

function ExecutableName(const AName: string): string;
begin
  if IsWindowsTarget then
    Result := AName + '.exe'
  else
    Result := AName;
end;

{ Runs a program with its output going to this script's output; the exit code. }
function Run(const AExecutable: string; const AArguments: array of string): Integer;
var
  Runner: TProcess;
  Index: Integer;
begin
  Runner := TProcess.Create(nil);
  try
    Runner.Executable := AExecutable;
    for Index := 0 to High(AArguments) do
      Runner.Parameters.Add(AArguments[Index]);
    Runner.Options := [poWaitOnExit];
    Flush(Output);
    Runner.Execute;
    { fpc 3.2.2's TProcess reports a Unix program's exit code in ExitStatus and leaves
      ExitCode at 0; take whichever is set. }
    Result := Runner.ExitStatus;
    if Result = 0 then
      Result := Runner.ExitCode;
  finally
    Runner.Free;
  end;
end;

{ Compiles one program into AOutputDirectory, with its units in their own directory.
  AExtraOption is added to the compiler's options when it is not empty. }
procedure CompileProgram(const ASource, AOutputDirectory, AName, AExtraOption: string);
var
  Arguments: TStringList;
  UnitDirectory: string;
  Index: Integer;
begin
  UnitDirectory := BuildDirectory + '/units/' + AName;
  ForceDirectories(UnitDirectory);
  ForceDirectories(AOutputDirectory);
  Arguments := TStringList.Create;
  try
    Arguments.Add('-Fu' + SourceDirectory);
    Arguments.Add('-Fi' + SourceDirectory);
    Arguments.Add('-FU' + UnitDirectory);
    Arguments.Add('-o' + AOutputDirectory + '/' + ExecutableName(AName));
    if Production then
      for Index := 0 to High(ProductionOptions) do
        Arguments.Add(ProductionOptions[Index])
    else
      for Index := 0 to High(DevelopmentOptions) do
        Arguments.Add(DevelopmentOptions[Index]);
    if AExtraOption <> '' then
      Arguments.Add(AExtraOption);
    Arguments.AddStrings(CompilerOptions);
    Arguments.Add(ASource);
    WriteLn('compile ', ASource);
    if Run(Compiler, Arguments.ToStringArray) <> 0 then
    begin
      WriteLn('build: ', ASource, ' did not compile');
      Halt(1);
    end;
  finally
    Arguments.Free;
  end;
end;

procedure BuildDriver;
begin
  EmbedAgent;
  CompileProgram(DriverSourcePath, BuildDirectory, 'hotfpc', '');
end;

{ The unit tests are hotfpc itself, compiled with HOTFPC_TESTS defined. }
procedure BuildTests;
begin
  EmbedAgent;
  CompileProgram(DriverSourcePath, BuildDirectory + '/tests', TestsName, TestsDefine);
end;

procedure RunTests;
var
  Executable: string;
begin
  BuildTests;
  Executable := BuildDirectory + '/tests/' + ExecutableName(TestsName);
  WriteLn('run ', Executable);
  if Run(Executable, []) <> 0 then
  begin
    WriteLn('build: the unit tests failed');
    Halt(1);
  end;
end;

procedure DeleteTree(const APath: string);
var
  Search: TSearchRec;
  Path: string;
begin
  if FindFirst(APath + '/*', faAnyFile, Search) = 0 then
  begin
    repeat
      if (Search.Name = '.') or (Search.Name = '..') then
        Continue;
      Path := APath + '/' + Search.Name;
      if (Search.Attr and faDirectory) <> 0 then
        DeleteTree(Path)
      else
        DeleteFile(Path);
    until FindNext(Search) <> 0;
    FindClose(Search);
  end;
  RemoveDir(APath);
end;

procedure Clean;
begin
  if DirectoryExists(BuildDirectory) then
    DeleteTree(BuildDirectory);
end;

procedure ReadArguments;
var
  Index: Integer;
  Argument: string;
  AfterSeparator: Boolean;
begin
  AfterSeparator := False;
  for Index := 1 to ParamCount do
  begin
    Argument := ParamStr(Index);
    if AfterSeparator then
      CompilerOptions.Add(Argument)
    else if Argument = '--' then
      AfterSeparator := True
    else if Argument = '--production' then
      Production := True
    else if (Argument = 'hotfpc') or (Argument = 'tests') or (Argument = 'embed') or (Argument = 'clean') then
      Targets.Add(Argument)
    else
    begin
      WriteLn('usage: instantfpc build.pas [hotfpc] [tests] [embed] [clean] [--production] [-- fpc options]');
      Halt(2);
    end;
  end;
end;

var
  Index: Integer;
begin
  Targets := TStringList.Create;
  CompilerOptions := TStringList.Create;
  try
    Production := False;
    Compiler := GetEnvironmentVariable('FPC');
    if Compiler = '' then
      Compiler := 'fpc';
    ReadArguments;
    if Targets.Count = 0 then
    begin
      Clean;
      BuildDriver;
      BuildTests;
    end;
    { clean first, wherever it was named }
    if Targets.IndexOf('clean') >= 0 then
      Clean;
    for Index := 0 to Targets.Count - 1 do
      if Targets[Index] = 'hotfpc' then
        BuildDriver
      else if Targets[Index] = 'tests' then
        RunTests
      else if Targets[Index] = 'embed' then
        EmbedAgent;
  finally
    Targets.Free;
    CompilerOptions.Free;
  end;
end.
