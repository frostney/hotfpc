program embed;
{ embed: writes a Pascal source file into an include file as an array of string constants,
  so that hotfpc carries the agent's source in its own binary. Run by build.sh and build.bat.

    embed hotagent.pas agentsource.inc }
{$mode objfpc}{$H+}

uses
  Classes, SysUtils;

// A Pascal expression for one line: quoted pieces of at most 200 characters (a literal may
// not exceed 255), other characters as #nn.
function Expr(const l: string): string;
var
  i, inLit: Integer;
begin
  if l = '' then Exit('''''');
  Result := '';
  inLit := 0;
  for i := 1 to Length(l) do
  begin
    if (l[i] >= ' ') and (l[i] <= '~') then
    begin
      if inLit = 0 then
      begin
        if Result <> '' then Result := Result + ' + ';
        Result := Result + '''';
      end;
      if l[i] = '''' then Result := Result + '''''' else Result := Result + l[i];
      Inc(inLit);
      if inLit = 200 then
      begin
        Result := Result + '''';
        inLit := 0;
      end;
    end
    else
    begin
      if inLit > 0 then Result := Result + '''';
      inLit := 0;
      if Result <> '' then Result := Result + ' + ';
      Result := Result + '#' + IntToStr(Ord(l[i]));
    end;
  end;
  if inLit > 0 then Result := Result + '''';
end;

var
  src, dst: TStringList;
  i: Integer;
  sep: string;
begin
  if ParamCount <> 2 then
  begin
    WriteLn('usage: embed source.pas output.inc');
    Halt(2);
  end;
  src := TStringList.Create;
  dst := TStringList.Create;
  try
    src.LoadFromFile(ParamStr(1));
    dst.Add('// Generated by embed from ' + ExtractFileName(ParamStr(1)) + '; do not edit.');
    dst.Add('const');
    dst.Add('  AgentSourceLines: array[0..' + IntToStr(src.Count - 1) + '] of string = (');
    for i := 0 to src.Count - 1 do
    begin
      if i < src.Count - 1 then sep := ',' else sep := '';
      dst.Add('    ' + Expr(src[i]) + sep);
    end;
    dst.Add('  );');
    dst.SaveToFile(ParamStr(2));
  finally
    src.Free;
    dst.Free;
  end;
end.
