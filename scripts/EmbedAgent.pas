#!/usr/bin/env instantfpc
program EmbedAgent;

{ Writes the agent's source and the shared compiler settings into build/generated/
  AgentSource.inc as arrays of string constants, so that hotfpc carries them in its own
  binary and can have the program's compiler build the agent (docs/how-it-works.md, "Why
  the agent is embedded"). Run by `lwpt build` as a prebuild hook, from the project root. }

{$mode delphi}{$H+}

uses
  Classes,
  SysUtils;

const
  AgentSourcePath = 'source/HotFPC.Agent.pas';
  SharedIncludePath = 'source/Shared.inc';
  OutputPath = 'build/generated/AgentSource.inc';
  { A string literal may not exceed 255 characters. }
  LiteralLimit = 200;

{ A Pascal expression for one line: quoted pieces of at most LiteralLimit characters, other
  characters as #nn. }
function LineExpression(const ALine: string): string;
var
  Index, LiteralLength: Integer;
begin
  if ALine = '' then
    Exit('''''');
  Result := '';
  LiteralLength := 0;
  for Index := 1 to Length(ALine) do
    if (ALine[Index] >= ' ') and (ALine[Index] <= '~') then
    begin
      if LiteralLength = 0 then
      begin
        if Result <> '' then
          Result := Result + ' + ';
        Result := Result + '''';
      end;
      if ALine[Index] = '''' then
        Result := Result + ''''''
      else
        Result := Result + ALine[Index];
      Inc(LiteralLength);
      if LiteralLength = LiteralLimit then
      begin
        Result := Result + '''';
        LiteralLength := 0;
      end;
    end
    else
    begin
      if LiteralLength > 0 then
        Result := Result + '''';
      LiteralLength := 0;
      if Result <> '' then
        Result := Result + ' + ';
      Result := Result + '#' + IntToStr(Ord(ALine[Index]));
    end;
  if LiteralLength > 0 then
    Result := Result + '''';
end;

procedure AddArray(const AOutput: TStringList; const AName, APath: string);
var
  Source: TStringList;
  Index: Integer;
  Separator: string;
begin
  Source := TStringList.Create;
  try
    Source.LoadFromFile(APath);
    AOutput.Add('  ' + AName + ': array[0..' + IntToStr(Source.Count - 1) + '] of string = (');
    for Index := 0 to Source.Count - 1 do
    begin
      if Index < Source.Count - 1 then
        Separator := ','
      else
        Separator := '';
      AOutput.Add('    ' + LineExpression(Source[Index]) + Separator);
    end;
    AOutput.Add('  );');
  finally
    Source.Free;
  end;
end;

var
  Output: TStringList;
begin
  Output := TStringList.Create;
  try
    Output.Add('{ Generated by scripts/EmbedAgent.pas from ' + AgentSourcePath + ' and ' + SharedIncludePath
      + '; do not edit. }');
    Output.Add('const');
    AddArray(Output, 'AgentSourceLines', AgentSourcePath);
    AddArray(Output, 'SharedIncludeLines', SharedIncludePath);
    ForceDirectories(ExtractFileDir(OutputPath));
    Output.SaveToFile(OutputPath);
  finally
    Output.Free;
  end;
end.
